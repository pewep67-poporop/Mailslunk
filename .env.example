PORT=8000
DATA_DIR=./data
GEOIP_DIR=../mailsleuth/geoip

# Offline-safe defaults
LIVE_DNS=0
LIVE_DNS_DOMAINS=5
GEO_IPS=20
COOKIE_SECURE=0
TRUST_PROXY=

# Admin bootstrap (legacy/dev only). Preferred: enroll with offline verifier
#   python tools/admin_keygen.py --user admin --cccd <CCCD> --write-db --key-out <file>
# ADMIN_PASS=

# Local AI only (optional). UI/kv settings are per-user; env values are fallbacks.
LLM_ENABLED=0
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_ALLOW_REMOTE=0

# Threat/content scan (local, offline-safe). Default layer always on (heuristics);
# optional engines run only if installed/configured locally (no Internet egress).
THREATSCAN_ENABLED=1
THREATSCAN_TIMEOUT=15
THREATSCAN_MAX_BYTES=26214400
# YARA_RULES_DIR=./rules/yara
# YARA_CLI=/usr/bin/yara
# CLAMSCAN_CLI=/usr/bin/clamdscan
# SANDBOX_URL=http://127.0.0.1:8090   # local/private sandbox adapter only

# SIEM export/push (optional). Leave empty = disabled/offline.
WAZUH_HOST=
WAZUH_PORT=5140
WAZUH_PROTO=udp
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
ELASTIC_URL=
ELASTIC_USER=
ELASTIC_PASS=
ELASTIC_API_KEY=
ELASTIC_INDEX=mailsleuth-case
SIEM_HOSTNAME=