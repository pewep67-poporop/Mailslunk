PORT=8000
DATA_DIR=./data
GEOIP_DIR=../mailsleuth/geoip
GEO_IPS=20
COOKIE_SECURE=0
TRUST_PROXY=

# Forensic offline: KHÔNG dùng DNS live / PTR live / API / SIEM / AI cloud.
# SPF/DKIM/DMARC và DNS lịch sử đọc từ Authentication-Results trong header
# và snapshot do người dùng cung cấp (P3). Biến DNS_SNAPSHOT trỏ tới file snapshot.

# Admin bootstrap (legacy/dev only). Preferred: enroll with offline verifier
#   python tools/admin_keygen.py --user admin --cccd <CCCD> --write-db --key-out <file>
# ADMIN_PASS=

# Quét nội dung đính kèm (offline/local). Lớp rule Python + thư viện local;
# P1 sẽ thay heuristic ad-hoc bằng rule file có test. Không timeout/tool ngoài.
THREATSCAN_ENABLED=1
THREATSCAN_TIMEOUT=15
THREATSCAN_MAX_BYTES=26214400

# Rate limit: stream gửi MỖI file = 1 request. Giá trị mặc định đủ cho lô lớn;
# khi vượt quá server trả 429 + Retry-After:60 và client tự đợi/thử lại.
RATE_ANALYZE_STREAM=1200
RATE_ANALYZE_BATCH=200
